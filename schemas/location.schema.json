{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyladies-kaohsiung.github.io/schemas/location.schema.json",
  "title": "Locations master list",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Stable lowercase-hyphen id, referenced by event.locations[]."
      },
      "name": { "type": "string", "minLength": 1 },
      "address":     { "type": "string" },
      "map_url":     { "type": "string", "format": "uri" },
      "is_online":   { "type": "boolean", "default": false }
    }
  }
}
