{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyladies-kaohsiung.github.io/schemas/topic.schema.json",
  "title": "Topics master list",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "category"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Stable lowercase-hyphen id, referenced by event.topic_id."
      },
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string" },
      "category": {
        "type": "string",
        "enum": ["workshop", "talk", "community"],
        "description": "Homepage filter group: workshop = Python 工作坊, talk = 技術與職涯經驗分享, community = 社群交流."
      }
    }
  }
}
